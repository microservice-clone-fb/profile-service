# Server Configuration
SERVER_PORT=8080
CONTEXT_PATH=/profile

# Application
SPRING_PROFILES_ACTIVE=prod
APP_NAME=profile-service

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/clone-fb-profile-service?authSource=admin

# External Services
FILE_SERVICE_URL=http://file-service:5004

# JWT Configuration (if needed)
JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRATION=86400000

# Logging
LOGGING_LEVEL=INFO
